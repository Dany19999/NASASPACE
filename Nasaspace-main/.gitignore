# ==========================================
# ASTRAHEALTH-AI - .gitignore
# ==========================================

# Entornos y Secretos
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Pruebas y Cobertura (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# Node.js y Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.vite/
frontend/dist/
frontend/build/

# IoT / ESP32 / PlatformIO / Wokwi
.pio/
.pioenvs/
*.bin
*.elf
*.hex

# IDEs y Editores
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Sistema Operativo
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
