# ============================================================================
# ASTRAHEALTH-AI Backend - Variables de Entorno (Plantilla de Desarrollo)
# ============================================================================
# Copia este archivo a '.env' en la carpeta backend/ y añade tus credenciales.
# El archivo '.env' está ignorado en Git para proteger los secretos del proyecto.

# Cadena de conexión PostgreSQL de Supabase (Settings -> Database -> Connection string URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
